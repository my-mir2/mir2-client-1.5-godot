; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the properties have not all been documented, and be careful of typos.

[configuration]

config_version=5

[application]

config/name="Mir2 Client 1.5"
config/description="Mir2 Legend of Mir 1.5 Client - C# Single-Track 100% Native Architecture"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=800
window/size/viewport_height=600
window/size/resizable=false
window/stretch/mode="disabled"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[gui]

theme/custom_font="res://resources/fonts/Songti.res"

